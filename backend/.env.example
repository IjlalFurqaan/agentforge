# AgentForge backend configuration. Copy to backend/.env for local development.
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional dedicated Fernet key for GitHub tokens (derived from SECRET_KEY when empty)
ENCRYPTION_KEY=

DATABASE_URL=sqlite+aiosqlite:///./data/agentforge.db
# DATABASE_URL=postgresql+asyncpg://agentforge:agentforge@localhost:5432/agentforge
REDIS_URL=
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Execution sandbox: docker (production) | seatbelt (macOS development only) | disabled
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=agentforge-sandbox:latest
# Enables `local` repositories under this directory (development only; relative to backend/)
LOCAL_REPOS_ROOT=
WORKER_MODE=embedded

# LLM providers. Model selection can also be set per agent:
# AGENT_MODELS={"developer": {"provider": "anthropic", "model": "claude-opus-5-5", "effort": "high"}}
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# Server-side refusal fallback for supported Claude models: default | off
ANTHROPIC_REFUSAL_FALLBACKS=default
OPENAI_API_KEY=
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDINGS_PROVIDER=none

# GitHub OAuth app (https://github.com/settings/developers); callback must match below
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/github/oauth/callback

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_JSON=true
